{
  "name": "vaqtpro",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "tsx scripts/checkBuildArtifacts.ts",
    "actions:check": "tsx scripts/checkActionPins.ts",
    "security:audit": "npm audit --audit-level=high",
    "license:check": "license-checker-rseidelsohn --excludePrivatePackages --summary --onlyAllow 'Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;CC-BY-3.0;CC-BY-4.0;CC0-1.0;ISC;MIT;MIT-0;MPL-2.0;OFL-1.1'",
    "lint": "eslint . --max-warnings=0",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=mobile-safari-portrait --project=chromium-execution-gate --project=webkit-execution-gate --project=webkit-analytics-bfcache --project=chromium-sw",
    "security:csp": "playwright test tests/security.spec.ts --project=chromium --workers=1",
    "smoke:offline": "playwright test tests/offline.spec.ts --project=chromium",
    "smoke:sw-update": "playwright test tests/sw-update.spec.ts --project=chromium-sw --no-deps --workers=1",
    "data:update:cities": "tsx scripts/update-city-data.ts",
    "preview": "vite preview",
    "data:build:geography": "tsx scripts/buildLocalGeography.ts",
    "data:check:geography": "tsx scripts/buildLocalGeography.ts --check"
  },
  "dependencies": {
    "adhan": "4.4.6",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.12.0",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "5.0.1",
    "terser": "5.51.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
